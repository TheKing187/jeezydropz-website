
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeezydropz-auto",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jeezydropz-content",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": ["0 */2 * * *"]
  }
}
